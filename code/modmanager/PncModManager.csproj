<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PncModManager</AssemblyName>
    <RootNamespace>PncModManager</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <RepoDir>$(MSBuildThisFileDirectory)..\..\</RepoDir>
    <!-- The build machine's absolute paths must not reach a shipped binary: the PDB path lands in
         the PE debug directory and every source path lands in the PDB, so an unmapped Release
         build publishes a username and a directory layout (§143). PathMap rewrites both to a
         repo-relative root, which also makes the output reproducible across machines.        -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(RepoDir)'))=./</PathMap>
    <!-- Same two roots PncEdi.csproj uses, for the same reasons: the game is outside the repo and
         reached through the symlink, and BepInEx comes from the pinned pack rather than from a
         game directory, so a build never depends on a deploy having happened.                  -->
    <GameDir Condition="'$(GameDir)' == ''">$(RepoDir)game-windows\</GameDir>
    <ManagedDir>$(GameDir)Post Nut Calamity_Data\Managed\</ManagedDir>
    <BepInExDir>$(RepoDir)code\dist\bepinex\core\</BepInExDir>
    <PluginDeployDir>$(RepoDir)BepInEx\plugins\</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExDir)BepInEx.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(BepInExDir)BepInEx.Unity.Mono.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(BepInExDir)SemanticVersioning.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckBepInExRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExDir)BepInEx.Core.dll')"
           Text="No BepInEx to compile against at $(BepInExDir). Run: python3 code/deploy.py --refs-only" />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -&gt; $(PluginDeployDir)" />
  </Target>
</Project>
